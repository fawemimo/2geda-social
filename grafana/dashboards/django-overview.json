{
  "title": "2geda Social - Overview",
  "uid": "2geda-overview",
  "tags": ["2geda", "django"],
  "schemaVersion": 36,
  "version": 1,
  "timezone": "browser",
  "panels": [
    {
      "title": "Request Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "rate(django_http_requests_before_middlewares_total[1m])",
          "legendFormat": "Requests/s"
        }
      ]
    },
    {
      "title": "Response Time (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(django_http_requests_before_middlewares_duration_seconds_bucket[1m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(django_http_requests_before_middlewares_duration_seconds_bucket[1m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(django_http_requests_before_middlewares_duration_seconds_bucket[1m]))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "title": "HTTP Status Codes",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "targets": [
        {
          "expr": "rate(django_http_responses_before_middlewares_total{status=~\"2.*\"}[1m])",
          "legendFormat": "2xx"
        },
        {
          "expr": "rate(django_http_responses_before_middlewares_total{status=~\"4.*\"}[1m])",
          "legendFormat": "4xx"
        },
        {
          "expr": "rate(django_http_responses_before_middlewares_total{status=~\"5.*\"}[1m])",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "title": "Redis Memory Usage",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "redis_memory_used_bytes",
          "legendFormat": "Used"
        },
        {
          "expr": "redis_memory_max_bytes",
          "legendFormat": "Max"
        }
      ]
    },
    {
      "title": "Redis Connected Clients",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "targets": [
        {
          "expr": "redis_connected_clients",
          "legendFormat": "Clients"
        }
      ]
    },
    {
      "title": "Redis Operations Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "targets": [
        {
          "expr": "rate(redis_commands_processed_total[1m])",
          "legendFormat": "Ops/s"
        }
      ]
    },
    {
      "title": "PostgreSQL Connections",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "pg_stat_activity_count{datname=~\"$db_name\"}",
          "legendFormat": "Active"
        }
      ]
    },
    {
      "title": "PostgreSQL Transactions",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{datname=~\"$db_name\"}[1m])",
          "legendFormat": "Committed"
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback{datname=~\"$db_name\"}[1m])",
          "legendFormat": "Rolled back"
        }
      ]
    },
    {
      "title": "Container CPU Usage",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16},
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{name=~\".*\"}[1m])",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "title": "Container Memory Usage",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "targets": [
        {
          "expr": "container_memory_usage_bytes{name=~\".*\"}",
          "legendFormat": "{{name}}"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "db_name",
        "type": "constant",
        "label": "Database",
        "query": "social_apidb",
        "current": {"value": "social_apidb"}
      }
    ]
  }
}
