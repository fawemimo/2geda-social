
# Django
SECRET_KEY=change-me-to-a-50-char-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=core.settings

# PostgreSQL
DB_NAME=social_api
DB_USER=postgres
DB_PASSWORD=strongpassword123
DB_HOST=postgres
DB_PORT=5432
DB_PORT_EXPOSE=5432

# Redis
REDIS_PASSWORD=redispassword123
REDIS_URL=redis://:redispassword123@redis:6379/0
REDIS_PORT_EXPOSE=6379

# RabbitMQ
RABBITMQ_USER=rabbit
RABBITMQ_PASSWORD=rabbitpassword123
RABBITMQ_VHOST=social_vhost
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_PORT_EXPOSE=5672
RABBITMQ_MGMT_PORT_EXPOSE=15672

# Celery
CELERY_BROKER_URL=amqp://rabbit:rabbitpassword123@rabbitmq:5672/social_vhost
CELERY_RESULT_BACKEND=redis://:redispassword123@redis:6379/1
CELERY_QUEUES=default,notifications,otp,media
CELERY_CONCURRENCY=4
CELERY_LOG_LEVEL=info

# Gunicorn
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
API_PORT_EXPOSE=8000

# Flower
FLOWER_USER=admin
FLOWER_PASSWORD=flowerpassword123
FLOWER_PORT_EXPOSE=5555

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@yourplatform.com

# Transport used by clients/email: resend | ses | console | memory
EMAIL_PROVIDER=resend

# Sender address used by every email provider
EMAIL_SENDER=noreply@yourplatform.com

# Resend provider (clients/email/providers/resend.py)
RESEND_API_KEY=re_your_api_key
RESEND_EMAIL_URL=https://api.resend.com/emails
RESEND_TIMEOUT=15

# SES provider (clients/email/providers/ses.py)
AWS_ACCESS_KEY_ID_SES=
AWS_SECRET_ACCESS_KEY_SES=

# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8080
RABBITMQ_MANAGEMENT_PORT=15672

# OTP / account tuning (defaults shown — override per env)
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_DAILY_QUOTA=20
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCKOUT_SECONDS=900

# ---- SMS / WhatsApp (clients/messaging) ----
# Ordered failover chain. If the first provider fails with a retryable error
# the next is tried immediately. Providers that do not serve the channel, or
# have no credentials, are skipped.
MESSAGING_PROVIDERS=twilio,termii,ebulksms
# Optional per-channel overrides:
# MESSAGING_PROVIDERS_SMS=ebulksms,termii,twilio
# MESSAGING_PROVIDERS_WHATSAPP=twilio,termii
# Skip a provider for N seconds after it fails (0 = disabled).
MESSAGING_FAILOVER_COOLDOWN_SECONDS=0
# Country code assumed for national-format numbers (Nigeria).
DEFAULT_PHONE_COUNTRY_CODE=234

# Twilio (SMS + WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1234567890
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Termii (SMS + WhatsApp)
TERMII_API_KEY=
TERMII_SENDER_ID=2geda
TERMII_BASE_URL=https://api.ng.termii.com

# EBulkSMS (SMS; WhatsApp only once EBULKSMS_WHATSAPP_URL is set)
EBULKSMS_USERNAME=
EBULKSMS_APIKEY=
EBULKSMS_SENDER_ID=2geda
EBULKSMS_BASEURL=https://api.ebulksms.com
# EBULKSMS_WHATSAPP_URL=

# Firebase
FCM_SERVER_KEY=

# ---- Object storage (clients/storage) ----
# Which backend owns uploaded files: s3 | azure | memory.
# No failover here — storage is stateful, so exactly one backend owns the data.
# The legacy STORAGE_TYPE=AWS is still honoured as an alias for "s3".
STORAGE_PROVIDER=s3

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
# Optional CDN in front of the bucket; derived from bucket+region when unset.
# AWS_S3_CUSTOM_DOMAIN=https://cdn.example.net

# Azure Blob Storage — either the connection string, or account name + key.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=media
# AZURE_STORAGE_CUSTOM_DOMAIN=https://cdn.example.net

# Docker / CI
DOCKER_REGISTRY=ghcr.io
GITHUB_REPOSITORY=your-org/social-api
IMAGE_TAG=latest
